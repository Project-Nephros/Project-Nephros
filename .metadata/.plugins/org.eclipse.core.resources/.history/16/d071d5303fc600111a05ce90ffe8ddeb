/* TEMPORARY TEST: UART1 RX -> UART2 TX (CoolTerm) */
#include "main.h"
#include "dma.h"
#include "usart.h"
#include "gpio.h"

#include <string.h>
#include <stdio.h>
#include <stdint.h>

void SystemClock_Config(void);

int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART2_UART_Init();
  MX_USART1_UART_Init();

  char ready[] = "basic UART1 test ready\r\n";
  HAL_UART_Transmit(&huart2, (uint8_t*)ready, strlen(ready), 100);

  uint8_t line[256];
  uint16_t len = 0;
  uint8_t b;
  while (1)
  {
      if (HAL_UART_Receive(&huart1, &b, 1, 10) == HAL_OK)
      {
          line[len++] = b;
          if (b == '\n' || len == sizeof(line))
          {
              HAL_UART_Transmit(&huart2, line, len, 100);
              len = 0;
          }
      }
      else
      {
          __HAL_UART_CLEAR_FLAG(&huart1, UART_CLEAR_OREF | UART_CLEAR_FEF | UART_CLEAR_NEF);
      }
  }
}

