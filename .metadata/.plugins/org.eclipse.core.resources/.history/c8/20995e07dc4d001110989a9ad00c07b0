/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART2_UART_Init();
  MX_ADC1_Init();
  MX_TIM1_Init();
  /* USER CODE BEGIN 2 */

  // start ADC polling for self testing
  HAL_TIM_Base_Start(&htim1);
  uint16_t ADC_VAL[3];
  HAL_ADC_Start_DMA(&hadc1, ADC_VAL, 3);

  char* bubble_message = "Bubble detected\r\n";
  char* fail_message = "Bubble sensor failure\r\n";

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  //example use of bubble_detected and bubble_sensor_failed
	  if (bubble_detected){
		  if (tx_complete){
        tx_complete = 0;
			  HAL_UART_Transmit_IT(&huart2, (uint8_t*)bubble_message, (int)strlen(bubble_message));
		  }
		  

		  //reset flag for testing purposes
		  bubble_detected = 0;
	  }

	  if (bubble_sensor_failed){
		  if (tx_complete){
        tx_complete = 0;
			  HAL_UART_Transmit_IT(&huart2, (uint8_t*)fail_message, (int)strlen(fail_message));
		  }

		  // hold the flag for testing purposes
		  bubble_sensor_failed = 1;
	  }


    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

