/* USER CODE BEGIN 4 */
/* Parse latest UART1 line into sensor_data. Only updates if all 8 fields read. */
static void read_sensors(NephrosSensorData *sensor)
{
    if (!data_ready_flag) return;
    data_ready_flag = 0;

    float t1, t2, p1, p2, f1, f2;
    int bubble;
    char status[20];

    int parsed = sscanf((char *)main_Buffer,
        "[T1=%f, T2=%f, Bubble=%d, Status=%19[^,], P1=%f, P2=%f, F1=%f, F2=%f]",
        &t1, &t2, &bubble, status, &p1, &p2, &f1, &f2);

    if (parsed == 8)
    {
        sensor->temperature_c = t1;
        sensor->air_detected  = (bubble != 0);
        sensor->pressure      = (uint16_t)p1;
        sensor->flow_rate     = f1;
    }

#if DEBUG_RX
    char dbg[64];
    NephrosUI_Write("RX: ");
    NephrosUI_Write((char *)main_Buffer);
    snprintf(dbg, sizeof(dbg), "  -> parsed %d/8\r\n", parsed);
    NephrosUI_Write(dbg);
#endif
}

/* UART1 line received (line went idle): copy, flag, restart DMA */
void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size)
{
    if (huart->Instance == USART1)
    {
        memcpy(main_Buffer, rx_Buffer, Size);
        main_Buffer[Size] = '\0';
        data_ready_flag = 1;
        HAL_UARTEx_ReceiveToIdle_DMA(&huart1, rx_Buffer, RX_BUFFER_SIZE);
    }
}

/* UART1 error (noise/framing/overrun): restart reception so it never dies */
void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        HAL_UARTEx_ReceiveToIdle_DMA(&huart1, rx_Buffer, RX_BUFFER_SIZE);
    }
}
