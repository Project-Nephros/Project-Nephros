/* USER CODE BEGIN 4 */
double readSmoothedTemperature(MovingAverage_t *ma, uint16_t rawSample)
{
    // Update moving average of raw ADC counts
    ma->buf[ma->idx] = rawSample;
    ma->idx = (ma->idx + 1) % WINDOW_SIZE;
    if (ma->count < WINDOW_SIZE) ma->count++;

    uint32_t sum = 0;
    for (uint8_t i = 0; i < ma->count; i++) {
        sum += ma->buf[i];
    }
    uint16_t avgRaw = (uint16_t)(sum / ma->count);

    if (avgRaw >= 4094)
        avgRaw = 4094;

    if (avgRaw <= 1)
        avgRaw = 1;

    // Convert smoothed ADC value to temperature
    double Vout = (avgRaw / ADC_MAX) * V_REF;
    double R_therm = R_FIXED * (Vout / (V_REF - Vout));
    double tempK = 1.0 / ((1.0 / T0) + (1.0 / BETA) * log(R_therm / R0));
    return tempK - 273.15;
}

float readPressureMMHg(PressureMA_t *ma, uint32_t rawADC)
{
    float v_adc = ((float)rawADC / ADC_MAX_COUNT) * VREF_VOLTS;
    float v_sensor = v_adc / DIVIDER_RATIO;

    float psi = (v_sensor - SENSOR_V_AT_ZERO) /
                (SENSOR_VOLTAGE_SPAN / SENSOR_PSI_MAX);

    if (psi < 0.0f)
        psi = 0.0f;
    if (psi > SENSOR_PSI_MAX)
        psi = SENSOR_PSI_MAX;

    float mmHg = psi * PSI_TO_MMHG;

    ma->buf[ma->idx] = mmHg;
    ma->idx = (ma->idx + 1) % MA_DEPTH;
    if (ma->count < MA_DEPTH)
        ma->count++;

    float sum = 0.0f;
    for (uint8_t i = 0; i < ma->count; i++)
        sum += ma->buf[i];

    return sum / ma->count;
}

void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance != TIM1) return;

    if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_1)
    {
        pulse_count_1++;
    }
    else if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_2)
    {
        pulse_count_4++;
        HAL_GPIO_TogglePin(LD3_GPIO_Port, LD3_Pin);
    }
}

static void flow_update(flow_ema_t *f, uint32_t window_pulses)
{
    double flow_Lmin  = (double)window_pulses * 60.0 / FLOW_PULSES_PER_LITRE;
    double flow_mLmin = flow_Lmin * 1000.0;

    if (!f->initialized) {
        f->avg_mLmin = flow_mLmin;
        f->initialized = 1;
    } else {
        f->avg_mLmin = FLOW_EMA_ALPHA * flow_mLmin + (1.0 - FLOW_EMA_ALPHA) * f->avg_mLmin;
    }
}

